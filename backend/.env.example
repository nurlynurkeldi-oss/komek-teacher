# Copy this file to .env and fill in values.

# Database (SQLite for the prototype; switch to PostgreSQL later, e.g.
# postgresql+psycopg://user:pass@localhost:5432/betterlearn)
DATABASE_URL=sqlite:///./data/app.db

# Where uploaded files are stored (local disk for the prototype)
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=20

# AI provider:
#   AI_MODE=gemini -> Google Gemini (needs GEMINI_API_KEY, from https://aistudio.google.com/apikey)
#   AI_MODE=claude -> Anthropic Claude (needs ANTHROPIC_API_KEY)
#   AI_MODE=mock   -> AI off: student work is accepted, the teacher grades by hand
AI_MODE=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded / unavailable:
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-2.5-flash

ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
